# Example settings for docker-compose.yml. Every line here is optional.
# Copy only the lines you change into your own .env. Most values shown are the
# defaults; host names and addresses are placeholders to replace. Commented
# lines (starting with #) are examples and stay off until you copy them.
# The app also reads config/config.yaml; a value set here overrides it.

# Host port exposed by Docker Compose.
APP_PORT=8080
# Host address the main UI port is published on. Set 127.0.0.1 to reach the UI
# only from the Docker host (for example behind a reverse proxy).
# APP_BIND_ADDRESS=0.0.0.0
# Numeric identity for the opt-in non-root UI and history services. Hardened
# admin uses the same GID, and backup adds it, so they can share only
# the prepared app state; backup secrets retain their separate ownership below.
APP_UID=10001
APP_GID=10001
# Which image to run. Leave unset to use the latest public GHCR image;
# latest remains the compatibility default. To stay on one version, use a release tag
# from the GitHub Releases page, for example ghcr.io/gcs8/truenas-jbod-ui:v0.23.0.
# For a pin that can never change underneath you, use the image digest form
# name@sha256:<digest> shown on that release.
JBOD_UI_IMAGE=
# Per-service memory ceilings. Docker Compose uses these values to contain a
# runaway process without starving the rest of the host. Admin restore uses
# file-backed 1 MiB chunks so its supported ceiling stays at 1 GiB; the separate
# one-shot backup worker retains extra headroom for large history snapshots.
APP_MEM_LIMIT=1g
HISTORY_MEM_LIMIT=1g
ADMIN_MEM_LIMIT=1g

# App behavior.
APP_LOG_LEVEL=INFO
LOG_FORMAT=text
APP_DEBUG=false
APP_REFRESH_INTERVAL=30
APP_CACHE_TTL=10
APP_CONFIG_PATH=/app/config/config.yaml
# Which system the main page opens on when config.yaml lists several. Leave
# unset to use the first system. Must match a systems[].id in config.yaml.
# SYSTEM_DEFAULT_ID=truenas-core-a
# How long data is reused before it is fetched again. The admin UI's timing
# panel edits the same values. APP_CACHE_TTL above is the older single setting;
# the two more specific values below win when set.
# How long a fetched inventory is shown before a background refresh starts.
# APP_SNAPSHOT_CACHE_TTL_SECONDS=10
# How long raw TrueNAS, SSH, and BMC answers are reused across pages.
# APP_SOURCE_BUNDLE_CACHE_TTL_SECONDS=60
# How long per-disk SMART details are kept before re-reading.
# APP_SMART_CACHE_TTL_SECONDS=300
# How long a discovered Linux enclosure device path is trusted before re-scanning.
# APP_SG_SES_DEVICE_CACHE_TTL_SECONDS=300
# Set `LOG_FORMAT=json` to emit structured JSON on stdout/syslog while keeping
# the local rotating app log file human-readable.
# Optional Prometheus/OpenMetrics scrape endpoint shared by the UI, history,
# and admin services. Disable only if you do not want `/metrics` exposed.
METRICS_ENABLED=true
METRICS_PATH=/metrics
# Optional syslog shipping. To make plain `docker compose up -d` auto-pick
# this up, copy `docker-compose.override.yml.example` to
# `docker-compose.override.yml` and set:
LOG_SYSLOG_ADDRESS=udp://syslog.example.local:514
LOG_SYSLOG_FORMAT=rfc5424micro
LOG_SYSLOG_FACILITY=local0
# Optional GitHub release check shown in the UI/admin/history surfaces.
# The interval cannot be shorter than 3600 seconds (one hour); smaller values
# are raised to 3600. A failed check is retried after 1 minute, 5 minutes,
# then hourly.
RELEASE_CHECK_ENABLED=true
RELEASE_CHECK_REPO=gcs8/truenas-jbod-ui
RELEASE_CHECK_INTERVAL_SECONDS=86400
RELEASE_CHECK_TIMEOUT_SECONDS=5

# TrueNAS API connection.
# Base appliance URL only, for example https://truenas.example.local
TRUENAS_HOST=https://truenas.example.local
# TrueNAS CORE/SCALE use API keys. Quantastor uses API user/password instead.
TRUENAS_API_KEY=
TRUENAS_API_USER=
TRUENAS_API_PASSWORD=
# Optional file-backed secrets are enabled with docker-compose.secrets.yml.
# A non-empty *_FILE setting takes precedence over the matching direct value.
# Blank *_FILE paths fail closed. The overlay sets these container paths:
# TRUENAS_API_KEY_FILE=/run/secrets/truenas_api_key
# TRUENAS_API_PASSWORD_FILE=/run/secrets/truenas_api_password
# SSH_PASSWORD_FILE=/run/secrets/ssh_password
# SSH_SUDO_PASSWORD_FILE=/run/secrets/ssh_sudo_password
# ADMIN_AUTH_PASSWORD_FILE=/run/secrets/admin_auth_password
# Keep a fallback .env private with `umask 077` and `chmod 600 .env`.
# Appliance family for the single-system env flow. Multi-system configs can set
# platform per system inside config/config.yaml.
TRUENAS_PLATFORM=core
# TrueNAS wire protocol: ddp (every CORE and SCALE release) or jsonrpc (SCALE
# 25.04 and newer). TRUENAS_API_VERSION applies to jsonrpc only.
# TRUENAS_API_DIALECT=ddp
# TRUENAS_API_VERSION=current
TRUENAS_VERIFY_SSL=false
# Optional custom CA bundle / TLS server-name override for private PKI or
# certificates whose hostname does not match TRUENAS_HOST directly.
TRUENAS_TLS_CA_BUNDLE_PATH=
TRUENAS_TLS_SERVER_NAME=
TRUENAS_TIMEOUT=15
TRUENAS_ENCLOSURE_FILTER=

# Optional SSH enrichment.
SSH_ENABLED=false
SSH_HOST=truenas.example.local
# Optional JSON array of extra SSH hosts for the same saved system, for example
# HA peers that share enclosure access.
SSH_EXTRA_HOSTS_JSON=[]
SSH_PORT=22
SSH_USER=jbodmap
SSH_KEY_PATH=/run/ssh/id_truenas
# Optional: use this for password-only appliances when SSH keys are not available.
SSH_PASSWORD=
# Optional: only needed if your TrueNAS CORE build supports command-limited sudo
# with a password, but not command-limited nopasswd sudo.
SSH_SUDO_PASSWORD=
SSH_STRICT_HOST_KEY_CHECKING=true
# Optional: where pinned host keys live. Leave unset for <data>/known_hosts
# (/app/data/known_hosts in the container). Set it to a path inside a host bind
# mount to keep keys outside the data volume; its folder must exist and be
# writable by APP_UID. The /app/data/known_hosts default counts as unset.
# SSH_KNOWN_HOSTS_PATH=/app/ssh-trust/known_hosts
SSH_TIMEOUT=15
# Non-root example that keeps glabel/zpool plain and uses command-limited sudo
# only for SES access:
# SSH_COMMANDS_JSON=["/sbin/glabel status","/usr/local/sbin/zpool status -gP","gmultipath list","sudo -n /usr/sbin/sesutil map","sudo -n /usr/sbin/sesutil show"]
# Optional if you also allow SSH identify LED control through command-limited sudo:
# SSH_COMMANDS_JSON=["/sbin/glabel status","/usr/local/sbin/zpool status -gP","gmultipath list","sudo -n /usr/sbin/sesutil map","sudo -n /usr/sbin/sesutil show","sudo -n /usr/sbin/sesutil locate -u /dev/ses4 16 on","sudo -n /usr/sbin/sesutil locate -u /dev/ses4 16 off"]
# Optional extra hint source if you also allow command-limited sudo for camcontrol:
# SSH_COMMANDS_JSON=["/sbin/glabel status","/usr/local/sbin/zpool status -gP","gmultipath list","sudo -n /usr/sbin/sesutil map","sudo -n /usr/sbin/sesutil show","sudo -n /sbin/camcontrol devlist -v"]
# SCALE-friendly example for Linux inventory awareness plus SES reads and LED-state refresh:
# SSH_COMMANDS_JSON=["/usr/sbin/zpool status -gP","/usr/bin/lsblk -o NAME,TYPE,SIZE,MODEL,SERIAL,TRAN,HCTL","/usr/bin/lsscsi -g","sudo -n /usr/bin/sg_ses -p aes /dev/sg27","sudo -n /usr/bin/sg_ses -p aes /dev/sg38","sudo -n /usr/bin/sg_ses -p ec /dev/sg27","sudo -n /usr/bin/sg_ses -p ec /dev/sg38"]
# Generic Linux mdadm/NVMe example:
# SSH_COMMANDS_JSON=["/usr/bin/lsblk -OJ","sudo -n /usr/sbin/mdadm --detail --scan","/usr/sbin/nvme list-subsys -o json"]
# Quantastor reads everything it needs through its API; SSH is optional there.
# smartctl does not need to be in SSH_COMMANDS_JSON; the app runs it on demand for the selected disk,
# but the SCALE user still needs sudo permission for /usr/sbin/smartctl.

# Layout and persistence.
LAYOUT_SLOT_COUNT=60
LAYOUT_ROWS=4
LAYOUT_COLUMNS=15
LAYOUT_SLOT_NUMBER_BASE=0
LAYOUT_API_SLOT_NUMBER_BASE=1
APP_STARTUP_WARM_CACHE_ENABLED=false
APP_STARTUP_WARM_SMART_ENABLED=false
APP_SMART_BATCH_MAX_CONCURRENCY=12
APP_SMART_PREFETCH_DELAY_MS=120
APP_SMART_PREFETCH_STRATEGY=auto
APP_SMART_PREFETCH_SINGLE_THRESHOLD=128
APP_SMART_PREFETCH_CHUNK_SIZE=24
APP_SMART_PREFETCH_BATCH_CONCURRENCY=2
APP_EXPORT_HISTORY_CONCURRENCY=12
# Upper bound for a synchronous CORE multipath rebuild or a tracked `disk.sync_all` job (#357).
APP_DISK_INVENTORY_SYNC_TIMEOUT_SECONDS=180
# How often that job is checked while it runs.
# APP_DISK_INVENTORY_SYNC_POLL_INTERVAL_SECONDS=2
APP_EXPORT_CACHE_TTL_SECONDS=60
APP_EXPORT_CACHE_MAX_ENTRIES=8
# Shared logical payload-byte ceiling across history, rendered HTML, and ZIP export caches.
APP_EXPORT_CACHE_MAX_BYTES=33554432
PATH_MAPPING_FILE=/app/data/slot_mappings.json
# Saved Storage Fabric link aliases.
# PATH_SAS_FABRIC_ALIAS_FILE=/app/data/sas_fabric_aliases.json
PATH_SLOT_DETAIL_CACHE_FILE=/app/data/slot_detail_cache.json
PATH_LOG_FILE=/app/logs/app.log
# Optional profile file for custom chassis layouts.
PATH_PROFILE_FILE=/app/config/profiles.yaml

# Optional performance timing for development / regression checks.
# Leave disabled in normal operation.
PERF_TIMING_ENABLED=false
PERF_LOG_ALL_REQUESTS=false
PERF_SLOW_REQUEST_MS=1000
PERF_SLOW_STAGE_MS=250

# Optional history sidecar. Start it with:
# docker compose --profile history up -d --build
# Note: the RELEASE_CHECK_* block above configures the main UI and the admin
# sidecar only. Compose does not pass those variables to enclosure-history, so
# a value set here does not reach the history sidecar and it keeps its own
# defaults for the release check.
# The main UI renders timestamps in the viewer's browser-local timezone.
HISTORY_PORT=8081
# Leave this on 127.0.0.1 unless you want another host, such as a communal
# Prometheus VM, to scrape the history sidecar directly.
HISTORY_BIND_ADDRESS=127.0.0.1
# The sidecar validates this explicit published address rather than its internal
# container bind. In the published Compose stack it is derived by Compose from
# HISTORY_BIND_ADDRESS above, so setting it here changes nothing; set it
# directly only when you run the history service outside that stack.
HISTORY_PUBLISHED_BIND_ADDRESS=127.0.0.1
# `network` is allowed only for loopback publication. For any wider bind the
# service refuses to start unless all three of these are set: `token` mode, a
# non-empty token (or token file), and one exact absolute browser origin in
# HISTORY_PUBLIC_ORIGIN.
HISTORY_REFRESH_AUTH_MODE=network
HISTORY_PUBLIC_ORIGIN=
HISTORY_FULL_REFRESH_COOLDOWN_SECONDS=900
HISTORY_REFRESH_TOKEN=
# HISTORY_REFRESH_TOKEN_FILE=/run/secrets/history_refresh_token
HISTORY_BACKEND_TIMEOUT=10
# Automatic SQLite mode repair is disabled by default. Prefer correcting host
# ownership and modes explicitly. If a bounded one-time repair is required,
# enable it temporarily; octal modes must not be world-writable.
HISTORY_PERMISSION_REPAIR_ENABLED=false
HISTORY_SHARED_DIR_MODE=0770
HISTORY_SHARED_FILE_MODE=0660
# Set only after the segmented-history migration publishes a complete catalog.
# HISTORY_SEGMENT_CATALOG_PATH=/app/history/segments/catalog.json
# In segmented mode, hot retention requires a recent successful scheduled FULL
# backup whose selected groups include history_db. The default accepts the daily
# timer's latest success for up to 36 hours and otherwise fails closed.
HISTORY_SEGMENTED_BACKUP_MAX_AGE_SECONDS=129600
HISTORY_BACKUP_DIR=/app/history/backups
HISTORY_BACKUP_RETENTION_COUNT=7
HISTORY_BACKUP_INTERVAL_SECONDS=86400
HISTORY_LONG_TERM_BACKUP_DIR=/app/history/backups/long-term
HISTORY_WEEKLY_BACKUP_RETENTION_COUNT=4
HISTORY_MONTHLY_BACKUP_RETENTION_COUNT=3
HISTORY_POLL_INTERVAL_SECONDS=300
HISTORY_FAST_INTERVAL_SECONDS=300
HISTORY_SLOW_INTERVAL_SECONDS=3600
HISTORY_REQUEST_TIMEOUT_SECONDS=45
HISTORY_FAILURE_BACKOFF_INITIAL_SECONDS=30
HISTORY_FAILURE_BACKOFF_MAX_SECONDS=900
HISTORY_SMART_BATCH_SIZE=24
HISTORY_STARTUP_GRACE_SECONDS=20
HISTORY_FORCE_INVENTORY_ON_FAST_COLLECTION=false
HISTORY_RAW_METRIC_RETENTION_DAYS=30
HISTORY_EVENT_RETENTION_DAYS=365
HISTORY_HOURLY_ROLLUP_RETENTION_DAYS=365
HISTORY_DAILY_ROLLUP_RETENTION_DAYS=1825
HISTORY_RETENTION_INTERVAL_SECONDS=3600
# How long retention waits for a usable backup before it prunes anyway.
HISTORY_RETENTION_BACKUP_SKIP_MAX_SECONDS=86400
HISTORY_RETENTION_BATCH_SIZE=5000
HISTORY_RETENTION_MAX_BATCHES_PER_RUN=20

# Optional admin sidecar. Start it with:
# docker compose --profile admin up -d --build
# or with published images:
# docker compose -f docker-compose.yml --profile admin up -d
ADMIN_PORT=8082
ADMIN_BIND_ADDRESS=0.0.0.0
ADMIN_TIMEOUT_SECONDS=0.75
# Stop admin this many seconds after it starts. The published Compose files use
# 3600; the application default is 0 (never), so keep a value here.
ADMIN_AUTO_STOP_SECONDS=3600
# Disk-backed host-prep upload spooling and staging inside the admin container.
# Compose points TMPDIR here too: keep it on the admin-only mount, not shared history or /tmp.
ADMIN_HOST_PREP_TEMP_DIR=/app/host-prep
# On admin startup, remove service-owned staged packages at least this old.
# Set to 0 to disable automatic pruning without changing the staging location.
ADMIN_HOST_PREP_STALE_TTL_SECONDS=86400
# Aggregate staging admission limits include packages retained across admin restarts.
ADMIN_HOST_PREP_MAX_PACKAGES=8
ADMIN_HOST_PREP_MAX_BYTES=2147483648
# `network` is the default with no authentication. Anyone who can reach the
# published ports can use them. main UI reads and writes are available.
# Set `basic` only when you want built-in authentication and strict origin checks.
ADMIN_AUTH_MODE=network
ADMIN_AUTH_USERNAME=
ADMIN_AUTH_PASSWORD=
# Optional in network mode. Required in `basic` mode for browser mutations, for example
# `https://storage-ui.example.local` or `http://192.0.2.10:8080`.
APP_PUBLIC_ORIGIN=
# Credential-bearing backup exports require encryption unless an operator
# explicitly opts into plaintext for a separately protected environment.
ADMIN_ALLOW_PLAINTEXT_BACKUP_EXPORT=false
ADMIN_CONTAINER_UI_LIVEZ_URL=http://enclosure-ui:8000/livez
ADMIN_CONTAINER_HISTORY_LIVEZ_URL=http://enclosure-history:8001/livez
ADMIN_CONTAINER_ADMIN_LIVEZ_URL=http://127.0.0.1:8002/livez
ADMIN_CONTAINER_VERSION_PROBE_TIMEOUT_SECONDS=1.5
# Optional: where the main UI should link for the admin surface when a reverse
# proxy or non-default public URL sits in front of the admin container.
ADMIN_PUBLIC_URL=
# Optional in network mode. In `basic` mode, set the exact origin
# (scheme://host[:port]) shown in the browser for the admin UI.
ADMIN_PUBLIC_ORIGIN=
ADMIN_CLEAN_BACKUP_TARGETS_JSON=["ui","history"]
# Optional one-shot encrypted state backup runner. A host timer invokes it; the
# privileged admin sidecar keeps its one-hour Compose auto-stop boundary.
SCHEDULED_BACKUP_ENABLED=false
SCHEDULED_BACKUP_DIR=
SCHEDULED_BACKUP_STATUS_FILE=
SCHEDULED_BACKUP_RETENTION_COUNT=0
# Segmented deployments must include history_db before retention can run.
# SCHEDULED_BACKUP_INCLUDED_GROUPS_JSON=["config_file","runtime_overrides_file","profile_file","mapping_file","sas_fabric_alias_file","slot_detail_file","history_db"]
SCHEDULED_BACKUP_INCLUDED_GROUPS_JSON=[]
SCHEDULED_BACKUP_PASSPHRASE_FILE=
BACKUP_MEM_LIMIT=3g
# Leave empty for Compose defaults: root-compatible base 0:0; nonroot/dev 1000:1000.
# Explicit IDs are preserved. A separate backup UID needs prepared shared history
# and matching private backup/status/passphrase ownership; see the backup guide.
BACKUP_UID=
BACKUP_GID=
# Optional backup scheduler sidecar (`--profile backup-scheduler`): config
# backups after config changes, cron full backups, remote copies, retention.
# Off by default. `backups:` in config.yaml sets the policy; these override it.
# See wiki/Backup-Restore-and-Debug-Bundles.md.
BACKUP_CONFIG_ENABLED=
BACKUP_CONFIG_DEBOUNCE_SECONDS=
BACKUP_CONFIG_MAX_DELAY_SECONDS=
BACKUP_CONFIG_LOCAL_KEEP=
BACKUP_CONFIG_REMOTE_KEEP=
BACKUP_CONFIG_REMOTE_MAX_AGE_DAYS=
BACKUP_FULL_ENABLED=
# Five-field cron or @daily/@weekly/...; times follow TZ (default UTC).
BACKUP_FULL_SCHEDULE=
# Time zone for the backup scheduler's cron times, for example America/New_York.
# TZ=UTC
BACKUP_FULL_LOCAL_KEEP=
BACKUP_FULL_REMOTE_KEEP=
BACKUP_FULL_REMOTE_MAX_AGE_DAYS=
# JSON array replacing backups.targets; credentials only as *_file paths.
BACKUP_TARGETS_JSON=
# Falls back to SCHEDULED_BACKUP_PASSPHRASE_FILE when empty.
BACKUP_ARCHIVE_PASSPHRASE_FILE=
BACKUP_SCHEDULER_MEM_LIMIT=3g
