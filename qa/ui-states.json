{
  "schema": 1,
  "about": "UI state inventory for the coverage crawler (qa/ui-crawl). Every interactive control in the templates and browser scripts must be named in a state's `covers` list or in `ignored_controls`; qa/ui-coverage.spec.js fails otherwise. `covers` means the state renders the control (and actuates it when the steps say so). See CONTRIBUTING.md, UI coverage.",
  "widths": {
    "release": [1600, 1920, 3840, 390],
    "pr": [1600, 1920, 3840],
    "ci": [1600, 3840]
  },
  "safety_classes": {
    "read": "Looks only. The crawler's network guard aborts every request that is not a GET/HEAD or a declared read POST, and every GET that forces an appliance refresh.",
    "app-write-revert": "Changes app-local state only (names, notes, display preferences, saved views/page order). The crawler records the original value, performs the write, performs the exact `revert` steps immediately, then reloads and re-reads to verify the original is back. Only the requests in `writes` are admitted, only while the state runs.",
    "led": "Turns a bay's identify (locate) light on and then off, and verifies it reads back off. Only POST .../led with IDENTIFY then CLEAR for the selected bay is admitted.",
    "forbidden": "Would change an appliance or array beyond the identify LED, an account or sudo, start a SMART test, back up or restore, purge or adopt history, or save configuration that reaches appliances. Listed for completeness and never actuated. With `confirm_preview` the crawler may press the control only to render a harmless native confirmation, which it always dismisses; the guard aborts the request in any case."
  },
  "read_posts": [
    {"method": "POST", "path": "/api/slots/smart-batch"},
    {"method": "POST", "path": "/api/storage-views/*/slots/smart-batch"},
    {"method": "POST", "path": "/api/history/scopes/bundle"},
    {"method": "POST", "path": "/api/export/enclosure-snapshot/estimate"}
  ],
  "pages": {
    "main": {"service": "ui", "path": "/", "ready": "main", "scopes": true, "description": "Enclosure page: chassis face, bay details, heat map, history drawer, connections panel, mapping, export."},
    "fabric": {"service": "ui", "path": "/sas-fabric", "ready": "fabric", "scopes": "enclosures", "description": "Storage Fabric page: Storage Lanes, Impact Map, Physical Trace and Disk Path tabs with the inspector."},
    "history": {"service": "history", "path": "/", "ready": "history", "description": "History sidecar dashboard."},
    "admin": {"service": "admin", "path": "/", "ready": "admin", "description": "Admin sidecar: Setup + Maintenance, Backups, Enclosure / Profile Builder."},
    "offline": {"service": "offline", "path": "/", "ready": "main", "description": "Offline snapshot export (the downloaded single-file copy and the public demo)."}
  },
  "selections": {
    "healthy": ".slot-tile.state-healthy[data-slot]",
    "empty": ".slot-tile.state-empty[data-slot]",
    "fault": ".slot-tile.state-fault[data-slot]",
    "unknown": ".slot-tile:is(.state-unknown, .state-unmapped)[data-slot]",
    "identify": ".slot-tile.state-identify[data-slot]"
  },
  "states": [
    {
      "id": "main.default", "page": "main", "safety": "read", "scope": "all", "ci": true,
