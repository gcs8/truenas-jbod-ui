      "covers": ["#system-select", "#enclosure-select", "#app-version-note", "#search-box", "#auto-refresh-toggle", "#refresh-interval-select", "#heatmap-toggle-button", "#sas-fabric-toggle-button", "#enclosure-alias-edit-button", "#export-snapshot-button", "#export-mappings-button", "#import-mappings-button", "#mapping-import-file", "#prefill-mapping-button", "[data-slot]", "#sas-fabric-view-link", "a\"System Setup\"@(root)", "button\"System Setup\"@#admin-launch-stopped"]
    },
    {
      "id": "main.summary-open", "page": "main", "safety": "read", "ci": true,
      "steps": [{"open": "#inventory-evidence-disclosure"}],
      "covers": ["#inventory-evidence-disclosure"]
