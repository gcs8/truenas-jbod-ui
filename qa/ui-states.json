      ],
      "revert": [
        {"reload": true},
        {"click": "#enclosure-alias-edit-button"}, {"waitFor": "#enclosure-alias-form:not(.hidden)"},
        {"fill": "#enclosure-alias-input", "text": "{alias}"},
